generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  clerkId          String         @unique
  isPremium        Boolean        @default(false)
  reportsThisMonth Int            @default(0)
  bonusReports     Int            @default(0)
  lastReportReset  DateTime       @default(now())
  createdAt        DateTime       @default(now())
  strategies       Strategy[]
  tasks            Task[]
  searchHistory    SearchHistory[]
  projects         Project[]
}

model Strategy {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productName     String
  niche           String
  keyword         String
  budget          Float
  readinessScore  Int
  gapAnalysis     String
  isPremium       Boolean  @default(false)
  createdAt       DateTime @default(now())
  tasks           Task[]
}

model Task {
  id          String   @id @default(cuid())
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stepNumber  Int
  description String
  isCompleted Boolean  @default(false)
  dueDate     DateTime
  createdAt   DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      String
  input     String
  output    String
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  reportData   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PageView {
  id         String   @id @default(cuid())
  userId     String?  // Clerk ID
  userEmail  String?  // Actual email
  path       String
  country    String?
  city       String?
  isLoggedIn Boolean  @default(false)
  createdAt  DateTime @default(now())
}